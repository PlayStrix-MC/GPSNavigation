// ===== GPSNavigation =====
// Конфиг на языке Jumper (*.jmc): https://github.com/jumper-lang/jumper
// Каждая переменная верхнего уровня — раздел настроек. Комментарии — // и /* */.
// После правки: /gps reload.
// Данные (карты, маркеры, зоны, NPC) хранятся отдельно: maps.jmc, markers.jmc, zone-points.jmc, npcs.jmc

dyn messages = {
    prefix: "<dark_green>[<green>GPS</green>]</dark_green> "
};

dyn road = {
    // Радиус автоматического соединения маркеров (по горизонтали, блоки)
    linkRadius: 5.0,
    // Максимальный перепад высоты для автоматической связи (склоны, лестницы, холмы)
    maxHeightDifference: 4.0,
    // Радиус ручной связи (Shift+ПКМ / /road link) — без ограничения высоты и проверки блоков:
    // мосты, этажи, лестницы, лифты
    manualLinkRadius: 16.0,
    // Запрещать автоматические связи, если между маркерами стоят стены (проверка на уровне груди и головы)
    checkLineOfSight: true,
    // Радиус привязки NPC к ближайшему маркеру
    npcLinkRadius: 5.0,
    // На каком расстоянии админ может «навестись» на маркер жезлом
    pickDistance: 8.0,
    // Задержка подтверждения удаления маркера/зоны кликом (мс)
    deleteConfirmMs: 3000
};

dyn zone = {
    // Радиус автоматического соединения точек мёртвой зоны (по горизонтали, высота точек не важна).
    // Замкнутый контур из соединённых точек превращает всю площадь внутри в мёртвую зону (на всех высотах).
    linkRadius: 5.0
};

dyn route = {
    // Указатели ставятся каждые N блоков маршрута...
    pointerSpacing: 3.0,
    // ...но не дальше N блоков впереди игрока
    pointerMaxDistance: 17.0,
    updateIntervalTicks: 5,
    // Отклонение от маршрута, после которого он пересчитывается
    recalculateDistance: 8.0,
    // Минимальный интервал между пересчётами (мс)
    recalculateCooldownMs: 1500,
    // Расстояние до NPC, при котором маршрут считается завершённым
    arriveDistance: 3.0,
    // Радиус поиска стартовых маркеров вокруг игрока
    startSearchRadius: 48.0,
    // Во сколько раз путь «по бездорожью» дороже пути по дороге (1.0 = без штрафа)
    offroadPenalty: 3.0
};

dyn pointer = {
    // "PACKET" — указатели отправляются пакетами только игроку с GPS, на сервере сущностей нет (рекомендуется).
    // "ENTITY" — запасной режим: скрытые от других несохраняемые сущности. Включается автоматически,
    //            если пакеты недоступны на этой версии ядра.
    mode: "PACKET",
    // Для режима ENTITY: "SHULKER_BULLET" или "ITEM_DISPLAY"
    entity: "SHULKER_BULLET",
    displayItem: "SHULKER_SHELL",
    // Указатели светятся (эффект свечения, виден даже с отключёнными частицами)
    glowing: true,
    // Высота указателя над уровнем маркера
    height: 1.0,
    // Свечение целевого NPC (контур) — видит только игрок с маршрутом.
    // Сущность NPC берётся из /gpsnpc bind или ищется рядом с точкой NPC; если её нет — над точкой светящийся указатель.
    npcGlow: true,
    npcHighlightDistance: 64.0
};

dyn displayLib = {
    // Если на сервере установлен DisplayLib — маршрут рисуется «тропой Ока Края»:
    // светящиеся Ока Края в узлах, поток искр к следующему узлу, фонарь у входов, золотая спираль у NPC,
    // салют по прибытии. Это display-сущности пакетами только для игрока с маршрутом.
    // Эффекты: plugins/GPSNavigation/displaylib/particles/*.jmc (правка + /displaylib reload).
    enabled: true,
    // Поток искр между узлами
    trail: true
};

dyn debug = {
    // Радиус отображения дорожной сети в /road show
    radius: 32.0,
    // Как часто перерисовывать частицы. 4 тика — частицы выглядят непрерывными (не мигают).
    updateIntervalTicks: 4,
    // Подписи ID над маркерами (персональные TextDisplay, не сохраняются в мире)
    labels: true,
    // Максимум частиц за одно обновление на игрока
    particleBudget: 4000
};

dyn guide = {
    // Модель предмета из ресурс-пака (например "myserver:gps_guide"). Пусто — стандартная книга знаний.
    itemModel: ""
};

dyn gui = {
    // "AUTO" — меню на экране DisplayLib (все NPC карточками, выбор с галочкой, кнопка «Проложить маршрут»),
    //          если DisplayLib установлен; иначе меню-инвентарь. "INVENTORY" — всегда меню-инвентарь.
    // Вёрстка экрана: plugins/GPSNavigation/displaylib/screens/gps_navigator.jmc
    style: "AUTO",
    // Где появляется экран DisplayLib: расстояние перед игроком (блоки) и высота центра относительно глаз.
    // 0.1 — центр чуть выше глаз, голову запрокидывать не нужно.
    screenDistance: 0.75,
    screenHeight: 0.1,
    // Закрывать меню после выбора NPC
    closeOnSelect: true,
    // Защита от повторной обработки клика (мс)
    clickDebounceMs: 250
};

dyn storage = {
    // Автосохранение данных (секунды)
    autosaveSeconds: 60
};
